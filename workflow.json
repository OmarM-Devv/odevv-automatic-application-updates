        "jsCode": "let relevant = false;\nif ($json.labelIds[0] == \"CATEGORY_PROMOTIONS\"){\n  return {\n    relevant\n  }\n}\n\nconst relevantWords = ['application', 'job', 'interest', 'career', 'position', 'assessment', 'interview'];\n// @ts-ignore\nconst subjectText = $json.headers.subject.toLowerCase();\nconst bodyText = $json.text.toLowerCase()\nfor (const word of relevantWords){\n  if (subjectText.includes(word) || bodyText.includes(word)){\n    relevant = true\n    return {\n      relevant\n    }\n  }\n}\n\nreturn {\n  relevant\n}"
      },
