    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let message = ''\nswitch ($json.STATUS){\n  case 'APPLIED': message = $json.COMPANY + ': application RECEIVED for ' + $json.ROLE; break\n  case 'REJECTED': message = $json.COMPANY + ': REJECTED for ' + $json.ROLE; break\n  case 'ASSESSMENT': message = $json.COMPANY + ': ' + 'invited to an ASSESSMENT for ' + $json.ROLE + '. For more details...'; break;\n  case 'INTERVIEW': message = $json.COMPANY + ': ' + 'invited to an INTERVIEW for ' + $json.ROLE + '. For more details...'; break;\n  case 'ASSESSMENT DONE': message = $json.COMPANY + ': ' + 'assessment RECEIVED for ' + $json.ROLE + '. For more details...'; break;\n  case 'INTERVIEW DONE': message = $json.COMPANY + ': ' + 'interview RECEIVED for ' + $json.ROLE + '. For more details...'; break;\n  case 'TO APPLY': message = $json.COMPANY + ': ' + 'job suggestion: ' + $json.ROLE + '. For more details...'; break;\n  //case 'UNKNOWN': ;\n  default: message = 'error while choosing message';\n}\nreturn {\n  message\n}"
      },
