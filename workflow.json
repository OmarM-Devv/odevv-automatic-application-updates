        "jsCode": "//function toDate(x){\n//  return new Date((x - 25569) * 86400 * 1000)\n//}\n\nfunction toSerial(x){\n  return Math.floor(x / (1000 * 60 * 60 * 24) + 25569)\n}\n\nfunction subtractDays(end, today){\n  return end - today\n}\n\nlet deadline = $json['ACTION DEADLINE'] //toDate($json['ACTION DEADLINE'])\nlet now = toSerial(new Date().getTime())\nlet daysLeft = subtractDays(deadline, now)\n\nif (daysLeft == 7 || daysLeft == 4 || daysLeft == 1){\n  let company = $json.COMPANY\n  let role = $json.ROLE\n  return {daysLeft, company, role}\n}\n\nreturn {}\n\n"
      },
